#!name=丰巢广告屏蔽
#!desc=屏蔽丰巢小程序取件后的广告加载，解决"加载中"卡死问题。需开启 MITM 并信任证书
#!author=ChatGPT
#!date=2025-10-30
#!system=ios

[Rewrite]
# --- 拦截丰巢广告统计跳转 ---
^https?:\/\/dsp\.fcbox\.com\/adBrowse\/countRedirect - reject-200

# --- 拦截58旗下广告页面 ---
^https?:\/\/z\d+\.58yuyue\.com\/h5\/ - reject-200

# --- 拦截备用广告域名（yuyueshangmen.com）---
^https?:\/\/.*yuyueshangmen\.com\/ - reject-200

[MITM]
hostname = dsp.fcbox.com, *.58yuyue.com, yuyueshangmen.com
